# Másold .env néven helyi fejlesztéshez; Vercelen a Project Settings → Environment Variables alá kerül.

# Postgres kapcsolat (Vercel Marketplace → Neon, vagy bármely Postgres)
DATABASE_URL=postgres://user:pass@host:5432/dbname

# 32 bájtos kulcs hex-ben (64 karakter): openssl rand -hex 32
# A KRÉTA refresh tokenek AES-256-GCM titkosításához. Elvesztése esetén minden KRÉTA-kapcsolatot újra kell létesíteni.
ENCRYPTION_KEY=

# Cron-végpont védelme (Vercel automatikusan Bearer tokenként küldi): openssl rand -hex 24
CRON_SECRET=

# Az alkalmazás nyilvános címe (e-mail linkekhez), záró perjel nélkül
APP_URL=http://localhost:3000

# Szinkronizálás: ennyi óránál gyakrabban nem frissít egy kapcsolatot a cron; ennyi napot kér le előre
SYNC_INTERVAL_HOURS=24
SYNC_DAYS=14

# Opcionális e-mail (Resend). Beállításig a jelszó-visszaállítás és az e-mail-megerősítés ki van kapcsolva.
RESEND_API_KEY=
EMAIL_FROM=KrétaSync <noreply@example.com>

# Ha a KRÉTA az időpontokat valódi UTC-ként adja (Z végű), állítsd true-ra. A kreta.py szerinti alapértelmezés: false (helyi idő).
KRETA_TIMES_ARE_UTC=false
